{
  "manifest_version": 3,
  "name": "Noxus Copilot",
  "version": "1.0.0",
  "description": "Turn a Noxus agent into a copilot that works in your browser and understands the platforms you're working in.",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Noxus Copilot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "adapters/salesforce.js",
        "adapters/hubspot.js",
        "adapters/generic.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle the Noxus copilot panel"
    }
  }
}
